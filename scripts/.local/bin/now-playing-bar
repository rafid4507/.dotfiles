#!/usr/bin/env bash
# ============================================================================
#  now-playing-bar — status text for the waybar custom/nowplaying module
#
#  Runs continuously and prints one frame per line (waybar reads each line).
#  Each frame is a small animated "equalizer" followed by the track name
#  scrolling right-to-left in a fixed-width window. Nothing is printed while
#  no player is playing, so the module hides itself.
#
#  The window width is constant so the bar never resizes while scrolling.
#
#  (Waybar cannot animate its built-in mpris module, hence this script.)
# ============================================================================
set -u

WIDTH=12                 # visible characters of the marquee window (short!)
GAP='   '                # gap between repeats of the title
DELAY=0.15               # seconds between frames (~6.7 fps)

SEP=$'\x1f'              # playerctl field delimiter
FMT="{{status}}${SEP}{{title}}${SEP}{{artist}}"
META="${TMPDIR:-/tmp}/now-playing-bar.$$"
: >"$META"               # create it now so the first frame's read never fails

# Animated equalizer frames (single-width block characters).
frames=('▁▂▃▄' '▂▄▅▃' '▃▅▆▄' '▄▃▂▁' '▃▂▁▂' '▂▁▂▃')

# ── Follow the active player, writing each metadata change to $META ──────────
(
    while true; do
        playerctl -p playerctld metadata --follow --format "$FMT" 2>/dev/null \
            | while IFS= read -r l; do printf '%s\n' "$l" >"$META"; done
        : >"$META"                       # player went away — clear the frame
        sleep 2
    done
) &
follow=$!
trap 'kill "$follow" 2>/dev/null; rm -f "$META"' EXIT

# ── Render frames forever ───────────────────────────────────────────────────
offset=0
frame=0
while true; do
    IFS="$SEP" read -r status title artist <"$META" 2>/dev/null || { status=""; title=""; artist=""; }

    if [[ "$status" == "Playing" && -n "$title$artist" ]]; then
        local_text="${artist:+$artist - }$title"
        eq="${frames[$((frame % ${#frames[@]}))]}"

        # Marquee: slide a WIDTH-wide window across "<text><gap>" (doubled so it
        # wraps seamlessly), always padded to WIDTH so the bar width is stable.
        full="$local_text$GAP"
        if (( ${#local_text} <= WIDTH )); then
            win="$local_text"
        else
            win="${full:offset:WIDTH}"
            (( ${#win} < WIDTH )) && win="$win${full:0:$((WIDTH - ${#win}))}"
        fi
        printf '%s %-*s\n' "$eq" "$WIDTH" "$win"
        offset=$(( (offset + 1) % ${#full} ))
        frame=$(( frame + 1 ))
    elif [[ "$status" == "Paused" && -n "$title" ]]; then
        printf '⏸  %-*s\n' "$WIDTH" "$title"
    else
        printf '\n'
    fi

    sleep "$DELAY"
done
