#!/usr/bin/env bash
# ============================================================================
#  now-playing — "now playing" popup
#
#  Watches the active MPRIS player (via playerctld) with playerctl and, every
#  time a new track starts playing, pops up a card with playback controls, the
#  track name (scrolling) and the artist.
#
#  It uses the small animated GTK4 + gtk4-layer-shell widget
#  (now-playing-widget) when those bindings are installed, and otherwise falls
#  back to a plain mako notification (styled by mako's [app-name=now-playing]
#  criteria). So it works out of the box and gets prettier once the optional
#  packages are present.
#
#  The player's cover art is deliberately NOT shown: players such as
#  Chromium/YouTube Music usually report an app or site logo there.
#
#  Started by niri (see niri/.config/niri/config.kdl). It is safe to leave
#  running forever: when no player is around it simply waits and retries.
#
#  Run it by hand to test:   now-playing &
# ============================================================================
set -u

APP_NAME="now-playing"
STACK_TAG="now-playing"          # mako replaces the previous popup (x-dunst-stack-tag)
SEP=$'\x1f'                      # unit separator — our playerctl field delimiter

# The animated popup lives next to this script. Resolve the Stow symlink so we
# find the real file in the repo (works whether run from ~/.local/bin or not).
SELF="$(readlink -f "$0")"
WIDGET="$(dirname "$SELF")/now-playing-widget"

# Prefer the animated widget when python-gobject + gtk4-layer-shell are around.
use_widget=0
if [[ -x "$WIDGET" ]] && python3 -c '
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gtk, Gtk4LayerShell
' >/dev/null 2>&1; then
    use_widget=1
fi

# status, title, artist, album — joined by the unit separator.
FMT="{{status}}${SEP}{{title}}${SEP}{{artist}}${SEP}{{album}}"

last_key=""
widget_pid=""

# Show the popup: the animated widget when available, else a mako notification.
popup() {
    local title="$1" artist="$2" album="$3"

    if (( use_widget )); then
        # One card at a time: drop the previous one before showing the new one.
        [[ -n "$widget_pid" ]] && kill "$widget_pid" 2>/dev/null
        setsid "$WIDGET" --title "$title" --artist "$artist" --album "$album" \
            >/dev/null 2>&1 &
        widget_pid=$!
        return 0
    fi

    local body="$artist"
    [[ -n "$album" ]] && body="${body:+$body — }$album"
    notify-send -a "$APP_NAME" -t 4000 -h "string:x-dunst-stack-tag:$STACK_TAG" \
        "$title" "$body"
}

notify_track() {
    local status="$1" title="$2" artist="$3" album="$4"

    # Only announce tracks that are actually playing...
    [[ "$status" == "Playing" ]] || return 0
    # ...and that have something to say.
    [[ -n "$title$artist" ]] || return 0

    # De-duplicate: playerctl re-prints the current track every time it
    # (re)connects, and we do not want a popup on every restart.
    local key="${title}|${artist}|${album}"
    [[ "$key" == "$last_key" ]] && return 0
    last_key="$key"

    [[ -n "$title" ]] || title="Now playing"
    popup "$title" "$artist" "$album"
}

# Follow the active player. When playerctld is not up (yet) playerctl exits at
# once, so we retry every couple of seconds until it is.
while true; do
    while IFS= read -r line; do
        IFS="$SEP" read -r status title artist album <<<"$line"
        notify_track "$status" "$title" "$artist" "$album"
    done < <(playerctl -p playerctld metadata --follow --format "$FMT" 2>/dev/null)
    sleep 2
done
