#!/usr/bin/env python3
# ============================================================================
#  now-playing-widget — compact, animated "now playing" popup
#
#  A tiny GTK4 + gtk4-layer-shell card that appears near the top of the screen
#  for a few seconds whenever a new track starts:
#
#      ⏮  ⏸  ⏭   Track name scrolls (12 chars at a time)
#                  Artist — Album
#
#  - Small playback buttons (previous / play-pause / next) instead of the
#    player's cover art — players such as Chromium/YouTube Music often report
#    an app or site logo there, which is noise.
#  - The name scrolls right-to-left in a short window; there is deliberately no
#    duration/seek bar. A little animated equalizer shows that audio is playing.
#  - Auto-hides after a few seconds, but stays put while the pointer is over it.
#
#  It is launched per track by scripts/.local/bin/now-playing, which falls back
#  to a plain (static) mako notification when the GTK4/layer-shell bindings are
#  not installed.
#
#  Requires: python-gobject, gtk4-layer-shell   (both in Arch's 'extra')
# ============================================================================
import argparse
import ctypes.util
import glob
import os
import sys


def _find_layer_shell_lib():
    """Locate libgtk4-layer-shell (needed for the LD_PRELOAD workaround)."""
    for pattern in ("/usr/lib/libgtk4-layer-shell.so*",
                    "/usr/lib64/libgtk4-layer-shell.so*",
                    "/usr/local/lib/libgtk4-layer-shell.so*"):
        hits = sorted(glob.glob(pattern))
        if hits:
            return hits[0]
    return ctypes.util.find_library("gtk4-layer-shell")


def _ensure_preload():
    """Re-exec with LD_PRELOAD set so gtk4-layer-shell initialises correctly.

    Loaded through GObject introspection, gtk4-layer-shell usually ends up
    linked *after* libwayland-client and layer surfaces then silently fail to
    initialise. Preloading the library fixes the load order. See
    https://github.com/wmww/gtk4-layer-shell/blob/main/linking.md
    """
    if os.environ.get("_NP_PRELOADED") == "1":
        return
    if "libgtk4-layer-shell" in os.environ.get("LD_PRELOAD", ""):
        os.environ["_NP_PRELOADED"] = "1"
        return
    lib = _find_layer_shell_lib()
    if not lib:
        return
    env = dict(os.environ)
    env["LD_PRELOAD"] = (lib + " " + env.get("LD_PRELOAD", "")).strip()
    env["_NP_PRELOADED"] = "1"
    os.execve(sys.executable,
              [sys.executable, os.path.realpath(__file__), *sys.argv[1:]],
              env)


_ensure_preload()

try:
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Pango", "1.0")
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gio, GLib, Gtk, Pango
    from gi.repository import Gtk4LayerShell as LayerShell
except Exception as exc:  # depends on the host, so fail softly
    sys.stderr.write(
        "now-playing-widget: needs python-gobject + gtk4-layer-shell (%s)\n" % exc
    )
    sys.exit(3)


EQ_FRAMES = ("▁▂▃▄", "▂▄▅▃", "▃▅▆▄", "▄▃▂▁", "▃▂▁▂", "▂▁▂▃")
MARQUEE_PX = 104        # width of the scrolling title window (~12 monospace chars)
MARQUEE_STEP = 1        # pixels moved per tick
MARQUEE_MS = 60         # ms between marquee ticks
EQ_MS = 130             # ms between equalizer frames
TOP_MARGIN = 48         # gap below the top of the screen (clears the bar)

CSS = """
.np-card {
    background: #1e1e2e;
    border: 2px solid #cba6f7;
    border-radius: 14px;
    padding: 8px 14px;
    font-family: "JetBrainsMono Nerd Font", monospace;
}
.np-title { color: #cba6f7; font-weight: 700; font-size: 14px; }
.np-sub   { color: #a6adc8; font-size: 11px; }
.np-eq    { color: #cba6f7; font-size: 15px; }
.np-scroll scrollbar { min-width: 0; min-height: 0; opacity: 0; }
.np-btn {
    background: none;
    border: none;
    box-shadow: none;
    padding: 0 2px;
    min-width: 0;
    min-height: 0;
    color: #cba6f7;
}
.np-btn:hover { color: #f5c2e7; }
.np-btn:active { color: #89b4fa; }
"""


def _load_css(provider):
    # GTK >= 4.12 has load_from_string; older PyGObject wants bytes.
    if hasattr(provider, "load_from_string"):
        provider.load_from_string(CSS)
    else:  # pragma: no cover - only on ancient bindings
        provider.load_from_data(CSS.encode())


class Popup(Gtk.Application):
    def __init__(self, title, artist, album, timeout):
        # NON_UNIQUE: one process per track, so a new popup never wakes an old
        # instance (which would leave the stale card on screen).
        super().__init__(application_id=None,
                         flags=Gio.ApplicationFlags.NON_UNIQUE)
        self._title = title or "Now playing"
        self._artist = artist
        self._album = album
        self._timeout = timeout
        self._eq = 0
        self._playing = True
        self._hover = False
        self._shown = False

    # ── small, text-styled icon buttons ─────────────────────────────────────
    def _icon_button(self, icon, tip, cmd):
        btn = Gtk.Button()
        btn.add_css_class("np-btn")
        btn.set_tooltip_text(tip)
        img = Gtk.Image.new_from_icon_name(icon)
        img.set_pixel_size(16)
        btn.set_child(img)
        btn.connect("clicked", lambda *_: GLib.spawn_command_line_async(cmd))
        return btn, img

    def do_activate(self):
        if self._shown:
            return
        self._shown = True

        win = Gtk.ApplicationWindow(application=self)
        win.set_decorated(False)

        # Turn the plain window into a floating, top-centred layer-shell surface.
        LayerShell.init_for_window(win)
        LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
        LayerShell.set_anchor(win, LayerShell.Edge.TOP, True)  # TOP only => centred
        LayerShell.set_margin(win, LayerShell.Edge.TOP, TOP_MARGIN)
        LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.NONE)

        provider = Gtk.CssProvider()
        _load_css(provider)
        Gtk.StyleContext.add_provider_for_display(
            win.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        card.add_css_class("np-card")

        # ── playback controls ───────────────────────────────────────────────
        controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        controls.set_valign(Gtk.Align.CENTER)
        prev_btn, _ = self._icon_button(
            "media-skip-backward-symbolic", "Previous", "playerctl previous")
        play_btn, play_img = self._icon_button(
            "media-playback-pause-symbolic", "Play / pause", "playerctl play-pause")
        next_btn, _ = self._icon_button(
            "media-skip-forward-symbolic", "Next", "playerctl next")
        for b in (prev_btn, play_btn, next_btn):
            controls.append(b)

        def on_play(_btn):
            GLib.spawn_command_line_async("playerctl play-pause")
            self._playing = not self._playing
            play_img.set_from_icon_name(
                "media-playback-pause-symbolic" if self._playing
                else "media-playback-start-symbolic")

        play_btn.connect("clicked", on_play)
        card.append(controls)

        # ── animated "playing" cue ──────────────────────────────────────────
        eq = Gtk.Label(label=EQ_FRAMES[0])
        eq.add_css_class("np-eq")
        eq.set_valign(Gtk.Align.CENTER)
        card.append(eq)

        # ── text column (fixed, short width) ────────────────────────────────
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        col.set_valign(Gtk.Align.CENTER)
        col.set_size_request(MARQUEE_PX, -1)

        # Title in a short scrolled window: it slides right-to-left when wider
        # than the window (the scrollbar itself is hidden via CSS).
        scroll = Gtk.ScrolledWindow()
        scroll.add_css_class("np-scroll")
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        # Keep the viewport at MARQUEE_PX wide instead of growing to fit the
        # whole title — that is what makes it a short, scrolling window.
        scroll.set_propagate_natural_width(False)
        scroll.set_size_request(MARQUEE_PX, -1)
        title = Gtk.Label(label=self._title)
        title.add_css_class("np-title")
        title.set_xalign(0.0)
        scroll.set_child(title)
        col.append(scroll)

        sub_text = self._artist
        if self._album:
            sub_text = (sub_text + " — " + self._album) if sub_text else self._album
        if sub_text:
            sub = Gtk.Label(label=sub_text)
            sub.add_css_class("np-sub")
            sub.set_xalign(0.0)
            sub.set_max_width_chars(12)
            sub.set_ellipsize(Pango.EllipsizeMode.END)
            col.append(sub)

        card.append(col)
        win.set_child(card)

        # ── animations ──────────────────────────────────────────────────────
        adj = scroll.get_hadjustment()

        def marquee():
            span = adj.get_upper() - adj.get_page_size()
            if span > 1:
                value = adj.get_value() + MARQUEE_STEP
                adj.set_value(0.0 if value > span else value)
            return True

        GLib.timeout_add(MARQUEE_MS, marquee)

        def equalize():
            self._eq = (self._eq + 1) % len(EQ_FRAMES)
            eq.set_text(EQ_FRAMES[self._eq])
            return True

        GLib.timeout_add(EQ_MS, equalize)

        # ── auto-hide (paused while the pointer is over the card) ───────────
        motion = Gtk.EventControllerMotion()

        def enter(*_a):
            self._hover = True

        def leave(*_a):
            self._hover = False

        motion.connect("enter", enter)
        motion.connect("leave", leave)
        win.add_controller(motion)

        def bye():
            if self._hover:
                return True
            win.destroy()
            self.quit()
            return False

        GLib.timeout_add(max(1000, int(self._timeout * 1000)), bye)

        win.present()


def main():
    ap = argparse.ArgumentParser(description="compact now-playing popup")
    ap.add_argument("--title", default="")
    ap.add_argument("--artist", default="")
    ap.add_argument("--album", default="")
    ap.add_argument("--timeout", type=float, default=8.0,
                    help="seconds to stay on screen (default 8)")
    args = ap.parse_args()
    Popup(args.title, args.artist, args.album, args.timeout).run(
        ["now-playing-widget"]
    )


if __name__ == "__main__":
    main()
