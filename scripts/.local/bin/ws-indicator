#!/usr/bin/env bash
# ============================================================================
#  ws-indicator — compact workspace indicator for waybar (custom module)
#
#  Shows a small dot for every workspace that actually has windows, and draws
#  the workspace you are currently on as a filled "tab" (a pango background
#  span). Empty workspaces are hidden. The output is pango markup, which
#  waybar's custom module interprets.
#
#  Names are trimmed to at most 12 characters so the indicator stays narrow.
#
#  Waybar's built-in niri/workspaces module cannot mix a name for one workspace
#  with dots for the others, hence this script.
#
#  (The file is deliberately NOT called "niri-workspaces": that made `niri`
#  + <Tab> in the shell complete to a confusing third entry.)
# ============================================================================
set -u

ws="$(niri msg --json workspaces 2>/dev/null)" || exit 0
[[ -n "$ws" ]] || exit 0
win="$(niri msg --json windows 2>/dev/null)"
[[ -n "$win" ]] || win='[]'

jq -nr --argjson ws "$ws" --argjson win "$win" '
    # How many windows each workspace has.
    ($win
     | map(select(.workspace_id != null))
     | group_by(.workspace_id)
     | map({key: (.[0].workspace_id | tostring), value: length})
     | from_entries) as $counts
    | ($ws | sort_by(.idx))
    | map(
        # Keep the label short: at most 12 characters.
        ((.name // (.idx | tostring))[0:12]) as $label
        | if .is_focused then
            # Current workspace: a filled tab (mauve background, dark text).
            "<span background=\"#cba6f7\" foreground=\"#1e1e2e\" weight=\"bold\"> \($label) </span>"
          elif (($counts[(.id | tostring)] // 0) > 0) then
            "<span foreground=\"#6c7086\">●</span>"
          else empty
          end
      )
    | join("  ")
'
