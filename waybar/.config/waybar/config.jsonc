// waybar — status bar for niri
// Docs: https://github.com/Alexays/Waybar/wiki
// This is JSONC: // comments are allowed.
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["mpris", "clock"],
    "modules-right": ["tray", "pulseaudio", "network", "cpu", "memory"],

    // ── niri ────────────────────────────────────────────────────────────────
    "niri/workspaces": {
        // Show ONLY the workspace you are currently on. niri keeps the named
        // workspaces (1-9 + "web") alive even when empty, which would otherwise
        // fill the bar with empty numbered placeholders. {value} prints the
        // workspace name (e.g. "web") or its index for unnamed workspaces.
        "current-only": true,
        "format": "{value}"
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true
    },

    // ── clock ───────────────────────────────────────────────────────────────
    "clock": {
        "format": "  {:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"
    },

    // ── now playing (MPRIS) ─────────────────────────────────────────────────
    // Follows the active player through playerctld (started by niri). Waybar
    // can only draw text, so this is the persistent "title — artist" readout
    // with play/pause/next/prev on click; the album art itself shows up in the
    // mako popup sent by ~/.local/bin/now-playing.
    "mpris": {
        "format": "♪  {dynamic}",
        "format-paused": "♪  {dynamic}",
        "format-stopped": "",
        "dynamic-len": 55,
        "title-len": 35,
        "artist-len": 25,
        "album-len": 0,
        "tooltip-format": "{player} — {status}\n{artist} — {title}\n{album}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    // ── system tray ─────────────────────────────────────────────────────────
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    // ── audio ───────────────────────────────────────────────────────────────
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    // ── network ─────────────────────────────────────────────────────────────
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "  {ifname}",
        "format-linked": "  {ifname}",
        "format-disconnected": "  offline",
        "tooltip-format": "{ifname}\n{ipaddr}/{cidr}\n{up} ↑  {down} ↓",
        "interval": 3
    },

    // ── resources ───────────────────────────────────────────────────────────
    "cpu": {
        "format": "  {usage}%",
        "interval": 2,
        "on-click": "kitty -e btop"
    },
    "memory": {
        "format": "  {percentage}%",
        "interval": 5,
        "on-click": "kitty -e btop"
    }
}
