// waybar — status bar for niri
// Docs: https://github.com/Alexays/Waybar/wiki
// This is JSONC: // comments are allowed.
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": ["custom/workspaces", "niri/window"],
    "modules-center": ["custom/nowplaying", "clock"],
    "modules-right": ["tray", "pulseaudio", "network", "cpu", "memory"],

    // ── niri ────────────────────────────────────────────────────────────────
    // Compact workspace indicator: a dot for every workspace that has windows,
    // plus the name of the one you are on (scripts/.local/bin/niri-workspaces).
    "custom/workspaces": {
        "exec": "$HOME/.local/bin/niri-workspaces",
        "interval": 1,
        "tooltip": false,
        "format": "{text}"
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true
    },

    // ── clock ───────────────────────────────────────────────────────────────
    "clock": {
        "format": "  {:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"
    },

    // ── now playing (MPRIS) ─────────────────────────────────────────────────
    // Animated readout from scripts/.local/bin/now-playing-bar: a small
    // equalizer plus the track name scrolling right-to-left. The script loops
    // and prints one frame per line, so there is no 'interval' — waybar streams
    // its output. Click to play/pause, right-click next, middle-click previous.
    "custom/nowplaying": {
        "exec": "$HOME/.local/bin/now-playing-bar",
        "restart-interval": 1,
        "tooltip": false,
        "format": "{text}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    // ── system tray ─────────────────────────────────────────────────────────
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    // ── audio ───────────────────────────────────────────────────────────────
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    // ── network ─────────────────────────────────────────────────────────────
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "  {ifname}",
        "format-linked": "  {ifname}",
        "format-disconnected": "  offline",
        "tooltip-format": "{ifname}\n{ipaddr}/{cidr}\n{up} ↑  {down} ↓",
        "interval": 3
    },

    // ── resources ───────────────────────────────────────────────────────────
    "cpu": {
        "format": "  {usage}%",
        "interval": 2,
        "on-click": "kitty -e btop"
    },
    "memory": {
        "format": "  {percentage}%",
        "interval": 5,
        "on-click": "kitty -e btop"
    }
}
