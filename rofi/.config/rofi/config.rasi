/* ============================================================================
 *  rofi — application launcher / window switcher / dmenu
 *
 *  Theme: "squared-material-red" from the newmanls rofi-themes-collection
 *  (squared corners, Material Darker palette, red accent). The theme file is
 *  shipped next to this config so it travels with the dotfiles.
 *
 *  Installed by GNU Stow as part of the "rofi" package:
 *    rofi/.config/rofi/config.rasi            -> ~/.config/rofi/config.rasi
 *    rofi/.config/rofi/themes/*.rasi          -> ~/.config/rofi/themes/
 *
 *  Try it:  rofi -show drun      (Mod+D)
 *           rofi -show window    (window switcher)
 * ========================================================================== */

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    terminal:            "kitty";

    /* Keep the list terse: just the app name. */
    drun-display-format: "{name}";
    display-drun:        " Apps";
    display-run:         " Run";
    display-window:      " Windows";
    window-format:       "{t}";

    /* Vi-style movement alongside the arrow keys. */
    kb-row-up:           "Up,Control+k";
    kb-row-down:         "Down,Control+j";
}

@theme "themes/squared-material-red.rasi"
