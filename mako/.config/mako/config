# mako — notification daemon (Catppuccin Mocha)
# Docs: man 5 mako

font=JetBrainsMono Nerd Font 10
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#cba6f7
border-size=2
border-radius=10
padding=12
margin=12
width=360
height=140
max-visible=5
anchor=top-right
default-timeout=8000
layer=overlay
icons=1
max-icon-size=48

[urgency=low]
border-color=#89b4fa
default-timeout=5000

[urgency=critical]
border-color=#f38ba8
default-timeout=0
