# mako — notification daemon (Catppuccin Mocha)
# Docs: man 5 mako
#
# Kept deliberately small and short-lived: the cards hug the top-right corner
# just under the bar and fade after ~3.5 s.

font=JetBrainsMono Nerd Font 10
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#cba6f7
border-size=2
border-radius=8
padding=8
margin=4
width=280
height=90
max-visible=3
anchor=top-right
default-timeout=3000
layer=overlay
icons=1
max-icon-size=28

[urgency=low]
border-color=#89b4fa
default-timeout=2000

[urgency=critical]
border-color=#f38ba8
default-timeout=0

# ── "Now playing" popup (fallback, sent by ~/.local/bin/now-playing) ─────────
# Only used when the animated GTK4 widget (now-playing-widget) is unavailable,
# i.e. when python-gobject / gtk4-layer-shell are not installed. A compact card
# with just the track name and artist — no cover art, because players often
# report an app/site logo there.
[app-name=now-playing]
anchor=top-center
default-timeout=3000
width=240
height=56
padding=8
border-color=#cba6f7
