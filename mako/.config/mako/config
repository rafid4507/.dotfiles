# mako — notification daemon (Catppuccin Mocha)
# Docs: man 5 mako

font=JetBrainsMono Nerd Font 10
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#cba6f7
border-size=2
border-radius=10
padding=12
margin=12
width=360
height=140
max-visible=5
anchor=top-right
default-timeout=8000
layer=overlay
icons=1
max-icon-size=48

[urgency=low]
border-color=#89b4fa
default-timeout=5000

[urgency=critical]
border-color=#f38ba8
default-timeout=0

# ── "Now playing" popup (sent by ~/.local/bin/now-playing) ───────────────────
# Album art on top, a larger cover, anchored at the top-centre of the screen.
# The watcher sets the cover as the notification icon; icon-location=top and a
# bigger max-icon-size turn the popup into a small "now playing" card.
[app-name=now-playing]
anchor=top-center
default-timeout=6000
width=380
height=320
padding=16
max-icon-size=180
icon-location=top
icon-border-radius=10
border-color=#cba6f7
